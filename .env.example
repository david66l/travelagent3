# ── Database ──
DATABASE_URL=postgresql+asyncpg://travelagent:travelagent123@postgres:5432/travel_agent
EMBEDDING_PROVIDER=disabled

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── LLM (Required) ──
# DeepSeek (default)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
DEFAULT_MODEL=deepseek-v4-flash
SMALL_MODEL=deepseek-v4-flash
REPAIR_MODEL=deepseek-v4-flash

# Alternative: OpenAI-compatible endpoint
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ── vLLM / local inference (M4) ──
# Enable when vLLM is running (docker compose -f docker-compose.yml -f docker-compose.vllm.yml --profile vllm up)
VLLM_ENABLED=false
LOCAL_LLM_ENABLED=false
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_API_KEY=not-needed

# ── Search (Tavily: https://tavily.com, free 1000 calls/month) ──
TAVILY_API_KEY=tvly-your-key-here
SEARCH_ENGINE=tavily

# ── App Settings ──
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Celery / Planning ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_PLANNING_QUEUE=planning
# celery: use Celery worker (docker-compose celery_worker); embedded: in-process poll loop
PLANNING_EXECUTOR=celery

# ── Cache (Redis L2, PRD §4.8) ──
CACHE_TTL_POI=21600
CACHE_TTL_WEATHER=3600
CACHE_TTL_PRICE=1800
CACHE_TTL_ITINERARY=43200
CACHE_TTL_ROUTE=86400
CACHE_TTL_JITTER_RATIO=0.1
CACHE_WARM_TOP_N_CITIES=20
LOCAL_CACHE_TTL_SECONDS=300

# Planning task retry / dead letter (PRD §4.7)
PLANNING_TASK_MAX_RETRIES=3
PLANNING_TASK_RETRY_INITIAL_SECONDS=2.0
PLANNING_TASK_RETRY_MAX_SECONDS=30.0
TASK_RETRY_COUNTER_TTL_SECONDS=604800
DEAD_LETTER_ARCHIVE_DAYS=7
CELERY_DEAD_LETTER_QUEUE=planning_dead_letter

# ── Crawler ──
CRAWL_RATE_LIMIT=1.0
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT=30

# ── Seed Data ──
SEED_DATA_DIR=backend/seed_data
SEED_CITIES=北京,上海,广州,深圳,成都,杭州,西安,重庆,苏州,南京,厦门,青岛,大理,丽江,三亚,长沙,武汉,昆明,桂林,拉萨

# ── Auth / JWT ──
JWT_SECRET=change-me-in-production
# 32-byte hex key for AES-256-GCM PII encryption. Generate with: openssl rand -hex 32
PRIVACY_ENCRYPTION_KEY=change-me-in-production-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_IP_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=60
# One normal planning flow opens several SSE requests (draft, modify, confirm).
RATE_LIMIT_GUEST_PER_MINUTE=30
RATE_LIMIT_MAX_CONCURRENT_SSE=3
# Keep 0 for SSE: net/http WriteTimeout otherwise caps the whole stream.
GATEWAY_WRITE_TIMEOUT=0s

# ── Observability (M5) ──
# Prometheus metrics exposed at /api/metrics
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# OpenTelemetry tracing (optional; set OTEL_ENABLED=true when collector is running)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=travel-agent-backend
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces

# ── MLflow (M5 model registry) ──
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTRY_URI=

# ── AI Safety (M5) ──
INPUT_SAFETY_ENABLED=true
OUTPUT_SAFETY_ENABLED=true

# ── Cost control & quotas (M6 §4.10) ──
COST_CIRCUIT_BREAKER_ENABLED=true
COST_CIRCUIT_BREAKER_DAILY_TOKENS=50000000
COST_CIRCUIT_BREAKER_DAILY_API_COST_CNY=1000
COST_CIRCUIT_BREAKER_HOURLY_GPU_COST_CNY=500
LLM_QUOTA_MEMBER_DAILY=500000
LLM_QUOTA_PREMIUM_DAILY=2000000
EXTERNAL_API_QUOTA_GUEST_DAILY=20
EXTERNAL_API_QUOTA_FREE_DAILY=200
EXTERNAL_API_QUOTA_MEMBER_DAILY=1000
EXTERNAL_API_QUOTA_PREMIUM_DAILY=5000
FREE_USER_ALLOW_LARGE_MODEL=true
PROMPT_COMPRESS_MAX_MESSAGES=12
PROMPT_COMPRESS_MAX_CHARS=2000
EXTERNAL_API_DEFAULT_COST_CNY=0.01

# Runtime mode: use the new LangGraph orchestration layer by default
# Agentic tool guard: off | shadow | enforce
AGENTIC_GUARD_MODE=shadow
AGENTIC_TOOL_CALL_BUDGET=12
