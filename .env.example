# ── Database ──
DATABASE_URL=postgresql+asyncpg://travelagent:travelagent123@postgres:5432/travel_agent

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── LLM (Required) ──
# OpenAI-compatible API endpoint
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Alternative: DeepSeek
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── Search (Tavily: https://tavily.com, free 1000 calls/month) ──
TAVILY_API_KEY=tvly-your-key-here
SEARCH_ENGINE=tavily

# ── App Settings ──
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Celery / Planning ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_PLANNING_QUEUE=planning
# celery: use Celery worker (docker-compose celery_worker); embedded: in-process poll loop
PLANNING_EXECUTOR=celery

# ── Cache (Redis L2, PRD §4.8) ──
CACHE_TTL_POI=21600
CACHE_TTL_WEATHER=3600
CACHE_TTL_PRICE=1800
CACHE_TTL_ITINERARY=43200
CACHE_TTL_ROUTE=86400
CACHE_TTL_JITTER_RATIO=0.1
CACHE_WARM_TOP_N_CITIES=20
LOCAL_CACHE_TTL_SECONDS=300

# Planning task retry / dead letter (PRD §4.7)
PLANNING_TASK_MAX_RETRIES=3
PLANNING_TASK_RETRY_INITIAL_SECONDS=2.0
PLANNING_TASK_RETRY_MAX_SECONDS=30.0
TASK_RETRY_COUNTER_TTL_SECONDS=604800
DEAD_LETTER_ARCHIVE_DAYS=7
CELERY_DEAD_LETTER_QUEUE=planning_dead_letter

# ── Crawler ──
CRAWL_RATE_LIMIT=1.0
CRAWL_MAX_RETRIES=3
CRAWL_TIMEOUT=30

# ── Seed Data ──
SEED_DATA_DIR=backend/seed_data
SEED_CITIES=北京,上海,广州,深圳,成都,杭州,西安,重庆,苏州,南京,厦门,青岛,大理,丽江,三亚,长沙,武汉,昆明,桂林,拉萨
