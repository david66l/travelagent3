# Non-secret Stage31 runtime contract. Copy these values into the deployment
# environment and inject endpoint credentials separately through a secret store.
AGENTIC_POLICY_MODE=shadow
AGENTIC_SHADOW_SAMPLE_RATE=0.05
AGENTIC_DEPLOYMENT_ID=stage31-local-shadow-v1
AGENTIC_POLICY_BACKEND=api
AGENTIC_POLICY_PROTOCOL=native_tool
AGENTIC_POLICY_ROUTING_ENABLED=true
AGENTIC_STUDENT_POLICY_MODEL=travel-policy-qwen3-4b-stage28-dpo-v2
AGENTIC_TEACHER_POLICY_MODEL=travel-policy-qwen3-8b-base
# The local Docker deployment reaches the SSH forwards on the host through
# these non-secret endpoints. Keep the remote vLLM services bound to loopback.
AGENTIC_STUDENT_BASE_URL=http://host.docker.internal:18000/v1
AGENTIC_TEACHER_BASE_URL=http://host.docker.internal:18002/v1
AGENTIC_STUDENT_MAX_TOKENS=128
AGENTIC_TEACHER_MAX_TOKENS=192
CELERY_SHADOW_QUEUE=shadow
