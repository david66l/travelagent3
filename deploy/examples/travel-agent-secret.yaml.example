# Example only. ArgoCD does not deploy this file because it is outside k8s/
# and does not use a Kubernetes manifest extension.
#
# Production must provision a Secret named travel-agent-secrets through an
# external secret manager (External Secrets Operator, Sealed Secrets, SOPS, or
# the platform's native secret injection). Never commit populated values.
apiVersion: v1
kind: Secret
metadata:
  name: travel-agent-secrets
  namespace: travel-agent
type: Opaque
stringData:
  JWT_SECRET: "replace-with-at-least-32-random-characters"
  PRIVACY_ENCRYPTION_KEY: "replace-with-an-independent-random-encryption-key"

  DATABASE_URL: "postgresql+asyncpg://travelagent:replace-me@postgres:5432/travel_agent"
  DATABASE_URL_SYNC: "postgresql://travelagent:replace-me@postgres:5432/travel_agent"
  REDIS_URL: "redis://redis-cluster:6379/0"

  POSTGRES_PASSWORD: "replace-with-a-random-database-password"
  POSTGRES_USER: "travelagent"
  POSTGRES_DB: "travel_agent"
  POSTGRES_REPLICATION_PASSWORD: "replace-with-an-independent-random-password"

  VLLM_API_KEY: "not-needed"
  OPENAI_API_KEY: ""
  DEEPSEEK_API_KEY: ""
  AMAP_KEY: ""
  WEATHER_KEY: ""
  TAVILY_API_KEY: ""
  ALERT_WEBHOOK_URL: ""
