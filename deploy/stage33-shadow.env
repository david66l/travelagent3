# Non-secret Stage33 champion/challenger Shadow contract.
# Endpoint credentials must be injected through a secret store.
AGENTIC_POLICY_MODE=shadow
AGENTIC_SHADOW_SAMPLE_RATE=0.05
AGENTIC_DEPLOYMENT_ID=stage33-1p7b-shadow-v1
AGENTIC_POLICY_BACKEND=api
AGENTIC_POLICY_PROTOCOL=native_tool
AGENTIC_POLICY_ROUTING_ENABLED=true

# Executed champion: distilled 1.7B SFT for bounded decisions, 8B for complex work.
AGENTIC_STUDENT_POLICY_MODEL=travel-policy-qwen3-1.7b-stage32-sft-formal
AGENTIC_TEACHER_POLICY_MODEL=travel-policy-qwen3-8b-base
AGENTIC_STUDENT_BASE_URL=http://host.docker.internal:18004/v1
AGENTIC_TEACHER_BASE_URL=http://host.docker.internal:18002/v1
AGENTIC_STUDENT_MAX_TOKENS=128
AGENTIC_TEACHER_MAX_TOKENS=192

# Non-authoritative challenger: output is recorded but never executed.
AGENTIC_CHALLENGER_SHADOW_ENABLED=true
AGENTIC_CHALLENGER_POLICY_MODEL=travel-policy-qwen3-1.7b-stage32-dpo-sftref-v2
AGENTIC_CHALLENGER_BASE_URL=http://host.docker.internal:18004/v1
AGENTIC_CHALLENGER_MAX_TOKENS=128

CELERY_SHADOW_QUEUE=shadow
