# Native ReAct policy serving. API keys remain in the untracked deployment secret file.
AGENTIC_POLICY_BACKEND=api
AGENTIC_POLICY_PROTOCOL=native_tool
AGENTIC_EXECUTION_MODE=react
AGENTIC_POLICY_MODEL=travel-sft
AGENTIC_DECISION_SPECIALIST_ENABLED=true
AGENTIC_DECISION_SPECIALIST_MODEL=travel-grpo-poi
AGENTIC_POLICY_ROUTING_ENABLED=false
VLLM_BASE_URL=http://127.0.0.1:8001/v1
