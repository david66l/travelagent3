  "probe_source": "\"\"\"Read-only branch probes: no model, provider, GPU or benchmark is called.\"\"\"\nimport asyncio\nimport json\nfrom agentic.loop import BoundedAgentLoop, PolicyAction, PolicyContext\nfrom agentic.policy_controller import ControllerFirstPolicy, constrain_policy_context\nfrom agentic.policy_actions import POLICY_ACTION_MODELS, policy_action_schemas_for_state, authorize_policy_action\nfrom agentic.policy_prompts import policy_prompt_payload\nfrom agentic.react import ReactTaskGraphPlanner\nfrom agentic.state import GoalLedger, AgentLedgerState\nfrom agentic.action_executor import TravelActionExecutor\nfrom agentic.recovery_contract import RecoveryDirective, ArgumentTransform, bind_recovery_contract\n\nclass DelegateReached(Exception):\n    pass\n\nclass ProbeDelegate:\n    def __init__(self):\n        self.context=None\n    async def propose(self,context):\n        self.context=constrain_policy_context(context)\n        raise DelegateReached()\n\ngoal=GoalLedger(original_request='杭州两天，关注无障碍景点，查询开放时间。',hard_constraints={'destination':'杭州','origin':'上海','travel_days':2,'start_date':'2026-10-01','end_date':'2026-10-02','current_info_queries':['西湖开放时间'],'information_needs':['opening_hours'],'transport_modes_requested':['train']},soft_preferences={'interests':['无障碍','博物馆']})\ngraph=ReactTaskGraphPlanner().plan(goal)\nledger=AgentLedgerState(goal=goal,task_graph=graph)\nresearch=graph.get('research_evidence')\n\ndef context(task='research_evidence',present=(),**kwargs):\n    node=graph.get(task)\n    payload=dict(trajectory_id='ownership-probe',goal_version=1,plan_version=1,original_request=goal.original_request,current_subtask=node.model_dump(mode='json'),hard_constraints=goal.hard_constraints,soft_preferences=goal.soft_preferences,capability={'status':'solvable'},relevant_fact_refs=[],relevant_artifact_refs=[],relevant_artifacts=[{'artifact_type':p} for p in present],failure_summary=[],remaining_tasks=6,remaining_steps=20,allowed_actions=list(node.allowed_actions))\n    payload.update(kwargs)\n    return PolicyContext(**payload)\n\nrequired=research.success_criteria['research_required_artifact_types']\ncases=[('research_multiple_gaps',context()),('research_only_current_info_missing',context(present=[x for x in required if x!='current_info_search'])),('research_all_artifact_types_present',context(present=required)),('review_hard_pass',context('review_itinerary',relevant_artifacts=[{'artifact_type':'validation_report','hard_pass':True}]))]\nfor task in ['solve_itinerary','validate_itinerary','compose_draft','await_confirmation']:\n    cases.append((task,context(task)))\ncases.append(('clarify_first_missing_field',context(missing_information=['origin','start_date'],capability={'status':'needs_user'})))\nfailure={'code':'QUERY_TOO_BROAD','message':'查询结果相关性不足，需要根据证据调整。','retryable':True,'retry_budget_remaining':2,'attempted_strategy':'search_pois','attempted_arguments':{'keywords':['无障碍','博物馆']}}\ncases.append(('search_failure_without_contract',context(failure_summary=[failure],decision_history=[{'task_id':'research_evidence','action':'search_pois','outcome_status':'failed'}])))\nexhausted=context()\nexhausted.current_subtask['action_attempt_counts']={'search_current_info':2}\ncases.append(('exhausted_no_alternatives',exhausted))\nexhausted_alt=exhausted.model_copy(deep=True,update={'capability':{'status':'missing_tool','actionable_alternatives':True,'alternatives':['请用户补充官方开放信息']}})\ncases.append(('exhausted_authorized_alternatives',exhausted_alt))\ncontract=bind_recovery_contract(RecoveryDirective(retry_mode='change_arguments',allowed_next_actions=('search_pois',),argument_transform=ArgumentTransform(remove_keyword_values=('博物馆',))),authority='internal_verifier',failure_id='probe-failure',action_id='probe-action',task_id='research_evidence',failed_action='search_pois',error_code='QUERY_TOO_BROAD',attempted_arguments={'keywords':['无障碍','博物馆']},evidence_refs=['probe-observation'],retry_budget_remaining=2,goal_version=1,plan_version=1)\ncases.append(('trusted_recovery_contract',context(active_recovery=contract.model_dump(mode='json'))))\n\nasync def main():\n    records=[]\n    for name,ctx in cases:\n        spy=ProbeDelegate()\n        try:\n            action=await BoundedAgentLoop._propose_or_execute_recovery(ControllerFirstPolicy(spy),ctx)\n            item={'controller_action':action.action,'controller_arguments':action.arguments,'decision_source':action.decision_source,'delegate_reached':False}\n        except DelegateReached:\n            visible=spy.context\n            item={'delegate_reached':True,'visible_actions':visible.allowed_actions,'visible_missing_information':visible.missing_information,'visible_argument_fields':{s['function']['name']:list(s['function']['parameters'].get('properties',{})) for s in policy_action_schemas_for_state(visible.allowed_actions,capability=visible.capability)}}\n        records.append({'probe':name,'kind':'synthetic_code_branch_not_task_evaluation',**item})\n    executor=TravelActionExecutor(tool_executor=object())\n    mutations=[]\n    for name,args in [('search_current_info',{'query':'自定义查询','info_type':'opening_hours','date':'2026-11-01'}),('search_transport',{'mode':'both','date':'2026-11-01'}),('search_pois',{'keywords':[]}),('search_pois',{'keywords':['无障碍']}),('solve_itinerary',{'strategy':'greedy'})]:\n        action=PolicyAction(action=name,arguments=args,model_arguments=args)\n        executed=executor._hydrate_arguments(ledger,action)\n        mutations.append({'action':name,'input':args,'hydrated_payload':executed,'changed_or_added_fields':[k for k in executed if executed[k]!=args.get(k) or k not in args],'action_record_after':action.arguments,'action_hydrated_fields_after':action.controller_hydrated_fields})\n    schemas={name:schema['function']['parameters'] for name in POLICY_ACTION_MODELS for schema in policy_action_schemas_for_state([name],capability={'status':'infeasible','actionable_alternatives':True,'alternatives':['A']})}\n    print(json.dumps({'scope':'read-only runtime branch and hydration probes; no real model decisions or full tasks','probes':records,'hydration_probes':mutations,'state_scoped_schemas':schemas,'react_tasks':[{'task_id':t.task_id,'depends_on':t.depends_on,'allowed_actions':t.allowed_actions} for t in graph.tasks]},ensure_ascii=False))\n\nasyncio.run(main())\n",
